---
BasedOnStyle: Google
ColumnLimit: 120                            # 120-character line limit
BreakBeforeBraces: Allman                   # Opening braces on a new line
AllowShortFunctionsOnASingleLine: None      # Function bodies never on the signature line
AllowShortEnumsOnASingleLine: false         # Enum bodies never on a single line
AllowShortLambdasOnASingleLine: Empty       # Only empty lambdas on a single line
AllowShortIfStatementsOnASingleLine: Never  # if bodies on their own line
AllowShortLoopsOnASingleLine: false         # Loop bodies on their own line
